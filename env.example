# ===========================================
# 스크린샷 분석기 환경 변수 설정
# ===========================================
# 이 파일을 .env로 복사하고 실제 API 키를 입력하세요.
# cp env.example .env

# -----------------------------------------
# 필수: OpenAI API 키 (Vision + 분석 + 보고서)
# -----------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------
# 선택: 다른 모델 제공자 (필요시)
# -----------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# GOOGLE_API_KEY=your-google-api-key

# -----------------------------------------
# 선택: 모델 설정 (기본값 사용 시 생략 가능)
# -----------------------------------------
# VISION_MODEL=gpt-4o
# ANALYSIS_MODEL=gpt-4o
# REPORT_MODEL=gpt-4o
# MAX_TOKENS=8192
# REPORT_MAX_TOKENS=10000

# -----------------------------------------
# 선택: 검색 설정
# -----------------------------------------
# MAX_SEARCH_RESULTS=5

# -----------------------------------------
# 선택: Agent 설정
# -----------------------------------------
# MAX_ANALYSIS_ITERATIONS=10

# -----------------------------------------
# 선택: LangSmith 트레이싱 (디버깅 & 공유용)
# -----------------------------------------
# https://smith.langchain.com에서 가입 후 API 키 발급
# 트레이싱을 활성화하면 에이전트 실행 과정을 시각화하고 공유할 수 있음
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
LANGSMITH_PROJECT=capture-insight
LANGSMITH_TRACING=true

