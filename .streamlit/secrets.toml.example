# Streamlit Secrets 설정 예시
# 
# 로컬 개발:
#   이 파일을 secrets.toml로 복사하고 실제 API 키 입력
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Streamlit Cloud 배포:
#   Settings > Secrets 에서 아래 내용 입력

# 필수: OpenAI API 키
OPENAI_API_KEY = "sk-your-openai-api-key"

# 필수: Tavily API 키 (https://tavily.com)
TAVILY_API_KEY = "tvly-your-tavily-api-key"

# 선택: LangSmith API 키 (https://smith.langchain.com)
LANGSMITH_API_KEY = "lsv2_pt_your-langsmith-api-key"
LANGSMITH_PROJECT = "capture-insight"
LANGSMITH_TRACING = "true"

